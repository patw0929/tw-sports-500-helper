{
  "expo": {
    "name": "揮汗有禮加碼券小幫手",
    "slug": "tw-sports-500-helper",
    "version": "1.2.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "twsports500helper",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "me.patw.twsports500helper",
      "icon": "./assets/images/icon.png",
      "buildNumber": "2",
      "supportsTablet": false
    },
    "android": {
      "package": "me.patw.twsports500helper",
      "versionCode": 2,
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FF5E1E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.USE_BIOMETRIC", "android.permission.USE_FINGERPRINT"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF5E1E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "請允許存取 Face ID 以保護加碼券身分個資。"
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "912c3037-6f60-4da0-a62b-e39659febab4"
      }
    },
    "owner": "patw",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/912c3037-6f60-4da0-a62b-e39659febab4",
      "fallbackToCacheTimeout": 3000
    }
  }
}
